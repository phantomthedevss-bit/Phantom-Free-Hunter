# ===== Telegram =====
# Create a bot via @BotFather on Telegram, copy the token it gives you.
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Your personal chat_id (or a channel id like -1001234567890).
# Get yours by messaging your bot once, then visiting:
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=123456789

# ===== Upstash Redis (free tier) =====
# Create a free Redis database at https://console.upstash.com
# Copy the REST URL and REST TOKEN from the database dashboard.
UPSTASH_REDIS_REST_URL=https://example-xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=AexampleUpstashTokenReplaceMe

# ===== Security =====
# A long random string YOU invent. GitHub Actions sends this as a Bearer
# token so randoms on the internet can't trigger your /api/hunt endpoint
# and burn your Telegram/Redis quota. Generate one with:
#   openssl rand -hex 32
CRON_SECRET=replace-with-a-long-random-string

# ===== Optional tuning =====
# Comma-separated category list to run (default: all). Useful for testing.
# Options: games,software,courses,ai,samples,assets,student,cloud
HUNT_CATEGORIES=

# How many days before an item is considered stale and purged from the
# "seen" dedup set even if still technically listed somewhere (default 14).
SEEN_TTL_DAYS=14
